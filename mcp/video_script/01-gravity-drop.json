                "perspective": 1200
              },
              "delay": 0,
              "duration": 2.5,
              "easing": "easeInOut"
            }
          ]
        },
        {
          "type": "text",
          "content": "Powerful Features",
          "font": "SF Pro Display",
          "font_size": 40,
          "font_weight": 700,
          "color": "#ffffff",
          "position": {
            "x": 50,
            "y": 85
          },
          "animations": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1,
              "delay": 1.2,
              "duration": 0.8,
              "easing": "easeOut"
            }
          ]
        }
      ]
    },
    {
      "id": "s4_settle_cta",
      "start": 10.5,
      "duration": 3.5,
      "elements": [
