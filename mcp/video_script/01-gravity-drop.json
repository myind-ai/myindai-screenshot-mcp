        {
          "type": "text",
          "content": "Download Free",
          "font": "SF Pro Display",
          "font_size": 34,
          "font_weight": 600,
          "color": "#ffffff",
          "position": {
            "x": 50,
            "y": 78
          },
          "animations": [
            {
              "property": "opacity",
