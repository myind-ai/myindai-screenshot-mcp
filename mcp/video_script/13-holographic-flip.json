        {
          "type": "text",
          "content": "Premium by Nature",
          "font": "SF Pro Display",
          "font_size": 44,
          "font_weight": 700,
          "color": "#ffffff",
          "position": {
            "x": 50,
            "y": 85
          },
          "animations": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1,
              "delay": 3.0,
              "duration": 1.0,
              "easing": "easeOut"
            }
          ]
        }
