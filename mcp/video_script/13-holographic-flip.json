              "easing": "cubicBezier(0.45, 0, 0.15, 1)"
            },
            {
              "property": "tilt3d",
              "from": {
                "rotateX": 5,
                "rotateY": 360,
                "perspective": 1200
              },
              "to": {
                "rotateX": -5,
                "rotateY": 375,
                "perspective": 1200
              },
              "delay": 3.0,
              "duration": 2.0,
              "easing": "easeInOut"
            }
          ]
        }
      ]
    },
    {
      "id": "s3_holo_exit",
      "start": 10,
      "duration": 5,
      "elements": [
        {
          "type": "holographic_overlay",
          "animations": [
            {
              "property": "intensity",
              "from": 0.4,
              "to": 0.8,
              "delay": 0,
              "duration": 2.0,
              "easing": "easeIn"
            },
            {
              "property": "intensity",
              "from": 0.8,
              "to": 0,
              "delay": 2.0,
              "duration": 2.0,
              "easing": "easeOut"
            }
          ]
        },
        {
          "type": "mockup",
          "screen": "holo_3",
          "animations": [
            {
              "property": "screenshot",
              "action": "crossfade",
