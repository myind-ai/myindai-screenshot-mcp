        {
          "type": "mockup",
          "screen": "luxury_3",
          "animations": [
            {
              "property": "screenshot",
              "action": "crossfade",
              "from_screen": "luxury_2",
              "to_screen": "luxury_3",
              "delay": 0,
              "duration": 1.0,
              "easing": "easeInOut"
            },
            {
              "property": "position",
              "from": {
                "x": 45,
                "y": 48
              },
              "to": {
                "x": 50,
                "y": 30
              },
              "delay": 1.0,
              "duration": 2.5,
              "easing": "easeInOut"
            },
            {
              "property": "tilt3d",
              "from": {
                "rotateX": 5,
                "rotateY": 8,
                "perspective": 1200
              },
              "to": {
                "rotateX": 0,
