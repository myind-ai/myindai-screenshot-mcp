        {
          "type": "text",
          "content": "Luxury Redefined",
          "font": "SF Pro Display",
          "font_size": 44,
          "font_weight": 300,
          "color": "#c9a96e",
          "position": {
            "x": 50,
            "y": 70
          },
          "animations": [
            {
              "property": "opacity",
              "from": 0,
              "to": 1,
