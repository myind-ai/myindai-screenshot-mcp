                "rotateX": 5,
                "rotateY": 8,
                "perspective": 1200
              },
              "delay": 0,
              "duration": 4.5,
              "easing": "easeInOut"
            },
            {
              "property": "position",
              "from": {
                "x": 50,
                "y": 48
              },
              "to": {
                "x": 55,
                "y": 47
              },
              "delay": 0,
              "duration": 2.5,
              "easing": "easeInOut"
            },
            {
              "property": "position",
              "from": {
                "x": 55,
                "y": 47
              },
              "to": {
                "x": 45,
                "y": 48
