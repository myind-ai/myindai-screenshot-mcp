          {
            "color": "#1a1a1a",
            "position": 100
          }
        ]
      },
      {
        "time": 8,
        "stops": [
          {
            "color": "#1a1a2e",
            "position": 0
          },
          {
            "color": "#0f0f23",
            "position": 100
          }
        ]
      },
      {
        "time": 16,
        "stops": [
          {
            "color": "#0a192f",
            "position": 0
          },
          {
            "color": "#172a45",
            "position": 100
          }
        ]
      },
      {
        "time": 25,
