{
  "_name": "Cinematic Story Arc",
  "_style": "Full narrative arc \u2014 problem \u2192 discovery \u2192 transformation \u2192 resolution, emotional storytelling",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration": 25,
    "format": "mp4",
    "codec": "h264",
    "bitrate": "12M"
  },
  "mockup": {
    "device": "iphone-16-pro-max",
    "frame_color": "black_titanium",
    "show_notch": true,
    "screen_radius": 55,
    "shadow": {
      "enabled": true,
      "color": "rgba(0,0,0,0.4)",
      "blur": 100,
      "offset": {
        "x": 0,
        "y": 50
