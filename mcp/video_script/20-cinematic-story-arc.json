      "spread": -10
    },
    "reflection": {
      "enabled": true,
      "opacity": 0.15,
      "blur": 12
    }
  },
  "screens": [
    {
      "id": "problem",
      "src": "screens/problem.png"
    },
    {
      "id": "discovery",
      "src": "screens/discovery.png"
    },
    {
      "id": "onboard",
      "src": "screens/onboard.png"
    },
    {
      "id": "transform",
      "src": "screens/transform.png"
    },
    {
      "id": "delight",
      "src": "screens/delight.png"
